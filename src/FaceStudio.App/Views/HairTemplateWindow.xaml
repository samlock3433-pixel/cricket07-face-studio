<Window x:Class="Cricket07.FaceStudio.Views.HairTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add hair from a template" Width="560" Height="640" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12" Background="White">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#333"
      Text="Choose the hair. The template head takes this head's shape and face texture and keeps its hair, which follows the new skull. The result opens in a new editor: shape and colour the hair there, then Save as .big. This head is not changed."/>
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Add this hair" Click="OnAdd" IsDefault="True" Background="#234E74" Foreground="White" Padding="14,6" Margin="0,0,8,0"/>
      <Button Content="Cancel" IsCancel="True" Padding="10,6"/>
    </WrapPanel>
    <ListBox x:Name="Templates" Padding="6" MouseDoubleClick="OnDoubleClick">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,3">
        <Image Source="{Binding PreviewPath}" Width="96" Height="88" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="15"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
