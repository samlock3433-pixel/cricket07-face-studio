<Window x:Class="Cricket07.FaceStudio.Views.TextureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Face Studio — Texture workspace" Width="1220" Height="800" MinWidth="900" MinHeight="600"
        Background="#F4F5F7" Closing="OnClosing">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Face Studio" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Search game textures, preview an image replacement, and export the complete package." Margin="0,4,0,14"/>
      <DockPanel>
        <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan folder…" Click="OnScan" Padding="14,6" Margin="8,0,0,0"/>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="OnCancel" IsEnabled="False" Padding="12,6"/>
        <TextBox x:Name="RootPath" Text="" Padding="7" VerticalContentAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="SearchBox" Margin="0,12,0,12" Padding="9" TextChanged="OnSearch"
               ToolTip="Search filenames, archive paths, FSH entry names, hashes, or your saved descriptive aliases."/>
    </StackPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="Choose your game folder and scan to begin." TextWrapping="Wrap" Margin="0,12,0,0"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="Results" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="OnSelection"
                EnableRowVirtualization="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Texture / container" Binding="{Binding Label}" Width="*"/>
          <DataGridTextColumn Header="Size" Binding="{Binding Dimensions}" Width="95"/>
          <DataGridTextColumn Header="Format" Binding="{Binding Encoding}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="Details" Text="Select a texture." TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock Text="Original" FontWeight="SemiBold"/>
          <Border Background="#252B35" Height="190" Margin="0,5,0,10"><Image x:Name="OriginalPreview" Stretch="Uniform"/></Border>
          <TextBlock Text="Encoded replacement" FontWeight="SemiBold"/>
          <Border Background="#252B35" Height="190" Margin="0,5,0,10"><Image x:Name="ReplacementPreview" Stretch="Uniform"/></Border>
          <TextBlock Text="Descriptive name / tags"/>
          <DockPanel Margin="0,5,0,10">
            <Button Content="Save alias" DockPanel.Dock="Right" Click="OnSaveAlias" Padding="10,4"/>
            <TextBox x:Name="AliasBox" Padding="6"/>
          </DockPanel>
          <WrapPanel>
            <Button x:Name="ImportButton" Content="Import BMP / TGA…" Click="OnImport" IsEnabled="False" Padding="12,7" Margin="0,0,8,8"/>
            <Button x:Name="ExportButton" Content="Export package…" Click="OnExport" IsEnabled="False" Padding="12,7" Margin="0,0,0,8"/>
            <Button Content="Scan report…" Click="OnReport" Padding="12,7"/>
          </WrapPanel>
          <TextBlock Text="Exports preserve the source layout. Use the main Face Studio window to open or create a head and hair model."
                     TextWrapping="Wrap" Foreground="#555D6A" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
