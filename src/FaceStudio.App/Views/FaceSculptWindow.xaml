<Window x:Class="Cricket07.FaceStudio.Views.FaceSculptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Face Studio — Head and hair editor" Width="1320" Height="860" MinWidth="980" MinHeight="620"
        Background="#1B1F26" Closing="OnClosing" Closed="OnClosed" PreviewKeyDown="OnKey" PreviewKeyUp="OnKeyUp">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="Accent" Color="#3D7EFF"/>
    <SolidColorBrush x:Key="PanelText" Color="#1F2933"/>
    <SolidColorBrush x:Key="Hint" Color="#5F6B7A"/>

    <!-- Dark top-bar button: icon + label. -->
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EBF1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,6" Margin="2,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2E3540"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#39414E"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BarIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>

    <!-- Tool rail: one tool active at a time, icon over a short label. -->
    <Style x:Key="RailTool" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Tools"/>
      <Setter Property="Foreground" Value="#C9D1DB"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="B" Background="Transparent" CornerRadius="6" Margin="5,2" Padding="0,7,0,5">
                <StackPanel>
                  <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="20" HorizontalAlignment="Center"/>
                  <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="10.5"/>
                </StackPanel>
              </Border>
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="2" Background="{StaticResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2A313B"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2F3D57"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Viewport overlay: small square icon buttons on a dark glass panel. -->
    <Style x:Key="ViewButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EBF1"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="4" MinWidth="30" Height="30" Padding="6,0" Margin="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3A4350"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#4A5566"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ViewText" TargetType="Button" BasedOn="{StaticResource ViewButton}">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Wireframe: a checkbox drawn as a toggle icon, so W and the code keep treating it as a checkbox. -->
    <Style x:Key="ViewToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6EBF1"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="B" Background="Transparent" CornerRadius="4" Width="30" Height="30" Margin="1">
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3A4350"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Right panel. -->
    <Style x:Key="Section" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="12,4,12,12"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E1E5EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource PanelText}"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="2,6"/>
    </Style>
    <Style x:Key="SectionIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,1,9,0"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,8,0,2"/>
      <Setter Property="Foreground" Value="{StaticResource PanelText}"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Hint}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,4"/>
    </Style>
    <Style x:Key="PanelButton" TargetType="Button">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="Nudge" TargetType="Button">
      <Setter Property="Padding" Value="0,5"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ===== Top bar: file and history ===== -->
    <Border DockPanel.Dock="Top" Background="#14171C" BorderBrush="#2A303A" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ExportButton" Click="OnExport" Style="{StaticResource BarButton}" Background="{StaticResource Accent}" Foreground="White"
            ToolTip="Saves the face you made as a .big file (model.o + textures.fsh) wherever you choose.">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource BarIcon}"/><TextBlock Text="Save as .big…"/></StackPanel>
          </Button>
          <Button Click="OnSave" Style="{StaticResource BarButton}" ToolTip="Save your work as a project to continue later.">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource BarIcon}"/><TextBlock Text="Save project"/></StackPanel>
          </Button>
          <Button Click="OnLoad" Style="{StaticResource BarButton}" ToolTip="Open a saved project.">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource BarIcon}"/><TextBlock Text="Open project"/></StackPanel>
          </Button>
          <Border Width="1" Background="#2E3540" Margin="8,4"/>
          <Button Click="OnUndo" Style="{StaticResource BarButton}" ToolTip="Undo (Ctrl+Z)">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource BarIcon}"/><TextBlock Text="Undo"/></StackPanel>
          </Button>
          <Button Click="OnRedo" Style="{StaticResource BarButton}" ToolTip="Redo (Ctrl+Y)">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A6;" Style="{StaticResource BarIcon}"/><TextBlock Text="Redo"/></StackPanel>
          </Button>
          <Border Width="1" Background="#2E3540" Margin="8,4"/>
          <Button Click="OnLikeness" Style="{StaticResource BarButton}" ToolTip="Fit the head shape to a front photo (and a side photo) of the player.">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource BarIcon}"/><TextBlock Text="Likeness from photos…"/></StackPanel>
          </Button>
          <Button Click="OnTexture" Style="{StaticResource BarButton}" ToolTip="Load a prepared texture image (game UV layout) onto the selected mesh part.">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource BarIcon}"/><TextBlock Text="Wrap UV texture…"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Status bar ===== -->
    <Border DockPanel.Dock="Bottom" Background="#14171C" BorderBrush="#2A303A" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <TextBlock x:Name="ToolHint" DockPanel.Dock="Right" Foreground="#8C97A5" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Status" Foreground="#D5DCE4" TextWrapping="Wrap" VerticalAlignment="Center"
          Text="Pick a tool on the left, then work on the head. Right drag orbits, the wheel zooms."/>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

      <!-- ===== Tool rail ===== -->
      <Border Background="#14171C" BorderBrush="#2A303A" BorderThickness="0,0,1,0" Width="74">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="SHAPE" Foreground="#6C7685" FontSize="9.5" HorizontalAlignment="Center" Margin="0,0,0,2"/>
          <RadioButton x:Name="ToolSculpt" Style="{StaticResource RailTool}" Tag="&#xE7C9;" Content="Sculpt" Click="OnToolRail" CommandParameter="sculpt" ToolTip="Sculpt: left drag pulls the surface (brush size in the panel)."/>
          <RadioButton x:Name="ToolVertex" Style="{StaticResource RailTool}" Tag="&#xE759;" Content="Vertex" Click="OnToolRail" CommandParameter="vertex" ToolTip="Single vertex (V): left drag moves one point of the mesh."/>
          <RadioButton x:Name="ToolShapePins" Style="{StaticResource RailTool}" Tag="&#xE718;" Content="Shape pins" Click="OnToolRail" CommandParameter="shape" ToolTip="Shape pins: pin a spot on the head and drag it onto the matching feature of a reference photo."/>
          <Border Height="1" Background="#2A303A" Margin="12,8"/>
          <TextBlock Text="TEXTURE" Foreground="#6C7685" FontSize="9.5" HorizontalAlignment="Center" Margin="0,0,0,2"/>
          <RadioButton x:Name="ToolPaint" Style="{StaticResource RailTool}" Tag="&#xE771;" Content="Paint" Click="OnToolRail" CommandParameter="paint" ToolTip="Paint: colour that keeps the texture's own detail. Alt or I picks a colour."/>
          <RadioButton x:Name="ToolBlur" Style="{StaticResource RailTool}" Tag="&#xE9A9;" Content="Blur" Click="OnToolRail" CommandParameter="blur" ToolTip="Blur: softens the texture under the brush."/>
          <RadioButton x:Name="ToolClone" Style="{StaticResource RailTool}" Tag="&#xE8C8;" Content="Clone" Click="OnToolRail" CommandParameter="clone" ToolTip="Clone: Ctrl+click sets the source, then paint to copy it."/>
          <RadioButton x:Name="ToolPinWarp" Style="{StaticResource RailTool}" Tag="&#xE840;" Content="Pin warp" Click="OnToolRail" CommandParameter="pinwarp" ToolTip="Pin warp: drag a painted feature (beard edge, lip line, brow) to where it belongs."/>
          <Border Height="1" Background="#2A303A" Margin="12,8"/>
          <TextBlock Text="PHOTO" Foreground="#6C7685" FontSize="9.5" HorizontalAlignment="Center" Margin="0,0,0,2"/>
          <RadioButton x:Name="ToolPhoto" Style="{StaticResource RailTool}" Tag="&#xE8B9;" Content="Move photo" Click="OnToolRail" CommandParameter="photo" ToolTip="Move photo: left drag moves the reference photo to line it up with the head."/>
        </StackPanel>
      </Border>

      <!-- ===== 3D view ===== -->
      <Grid Grid.Column="1">
        <h:HelixViewport3D x:Name="Viewport" Background="#252B35" ZoomExtentsWhenLoaded="False" ShowViewCube="False" Focusable="True"
                          IsRotationEnabled="False" IsPanEnabled="False" IsZoomEnabled="False"
                          PreviewMouseDown="OnPointerDown" PreviewMouseMove="OnPointerMove" PreviewMouseUp="OnPointerUp" PreviewMouseWheel="OnWheel" LostMouseCapture="OnCaptureLost" MouseLeave="OnViewportLeave">
          <h:HelixViewport3D.Camera><PerspectiveCamera Position="0,0,3" LookDirection="0,0,-3" UpDirection="0,1,0" FieldOfView="35"/></h:HelixViewport3D.Camera>
          <h:SunLight/>
        </h:HelixViewport3D>
        <Canvas x:Name="PinLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        <Canvas x:Name="ShapePinLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        <!-- Brush ring for texture paint: dark outline under a white line, visible on light and dark skin. -->
        <Canvas x:Name="CursorLayer" IsHitTestVisible="False" ClipToBounds="True">
          <Path x:Name="BrushRingShadow" Stroke="#A0000000" StrokeThickness="3" Visibility="Collapsed" StrokeLineJoin="Round"/>
          <Path x:Name="BrushRing" Stroke="White" StrokeThickness="1.2" Visibility="Collapsed" StrokeLineJoin="Round"/>
          <Ellipse x:Name="VertexMarker" Width="11" Height="11" Fill="#FFFFD23C" Stroke="Black" StrokeThickness="1.5" Visibility="Collapsed"/>
          <Ellipse x:Name="VertexMirrorMarker" Width="9" Height="9" Stroke="#FFFFD23C" StrokeThickness="1.5" Opacity="0.7" Visibility="Collapsed"/>
        </Canvas>

        <!-- View controls, top right. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="4" CornerRadius="6" Background="#C8141820">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ViewButton}" Content="&#xE76B;" Tag="orbit-left" Click="OnNavigate" ToolTip="Turn left (Left arrow)"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE70E;" Tag="orbit-up" Click="OnNavigate" ToolTip="Tilt up (Up arrow)"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE70D;" Tag="orbit-down" Click="OnNavigate" ToolTip="Tilt down (Down arrow)"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE76C;" Tag="orbit-right" Click="OnNavigate" ToolTip="Turn right (Right arrow)"/>
              <Border Width="1" Background="#3A4350" Margin="3,6"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE8A3;" Tag="zoom-in" Click="OnNavigate" ToolTip="Zoom in (+, wheel, pinch)"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE71F;" Tag="zoom-out" Click="OnNavigate" ToolTip="Zoom out (-, wheel, pinch)"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE71E;" Tag="focus" Click="OnNavigate" ToolTip="Frame the clicked spot closely"/>
              <Button Style="{StaticResource ViewButton}" Content="&#xE740;" Tag="fit" Click="OnNavigate" ToolTip="Show the whole head (F)"/>
              <Border Width="1" Background="#3A4350" Margin="3,6"/>
              <CheckBox x:Name="ShowWireframe" Style="{StaticResource ViewToggle}" Tag="&#xE879;" Click="OnWireframe" ToolTip="Show wireframe (W)"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
              <Button Style="{StaticResource ViewText}" Content="Front" Tag="front" Click="OnNavigate" ToolTip="Front view (Home)"/>
              <Button Style="{StaticResource ViewText}" Content="&#xBE;" Tag="threequarter" Click="OnNavigate" ToolTip="Three-quarter view"/>
              <Button Style="{StaticResource ViewText}" Content="Left" Tag="left" Click="OnNavigate" ToolTip="Left side"/>
              <Button Style="{StaticResource ViewText}" Content="Right" Tag="right" Click="OnNavigate" ToolTip="Right side"/>
              <Button Style="{StaticResource ViewText}" Content="Back" Tag="back" Click="OnNavigate" ToolTip="Back view"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Foreground="#8C97A5" FontSize="11.5" IsHitTestVisible="False"
          Text="Right drag (or Alt + left drag): orbit   ·   Shift + right drag: pan   ·   Wheel or pinch: zoom   ·   F: fit   ·   Home: front"/>
      </Grid>

      <!-- ===== Right panel ===== -->
      <Border Grid.Column="2" Background="#F2F4F7" BorderBrush="#2A303A" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
          <StackPanel TextElement.Foreground="{StaticResource PanelText}">

            <!-- Hidden mode switches: the tool rail drives them; tools and tests read them. -->
            <StackPanel Visibility="Collapsed">
              <CheckBox x:Name="VertexMode" Click="OnVertexMode"/>
              <CheckBox x:Name="ShapePins" Click="OnShapeMode"/>
              <CheckBox x:Name="ReferenceEdit" Click="OnReferenceEdit"/>
              <ComboBox x:Name="HeadTool" SelectedIndex="0" SelectionChanged="OnHeadTool">
                <ComboBoxItem Content="Sculpt (no paint)"/>
                <ComboBoxItem Content="Paint" Tag="Paint"/>
                <ComboBoxItem Content="Blur" Tag="Blur"/>
                <ComboBoxItem Content="Clone" Tag="Clone"/>
                <ComboBoxItem Content="Pin warp" Tag="Pins"/>
              </ComboBox>
            </StackPanel>

            <!-- ===== Active tool and its options ===== -->
            <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" Padding="12,10,12,12" Margin="0,0,0,10" CornerRadius="4">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Background="{StaticResource Accent}" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0">
                    <TextBlock x:Name="ToolIcon" Text="&#xE7C9;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE TOOL" FontSize="9.5" Foreground="{StaticResource Hint}"/>
                    <TextBlock x:Name="ToolTitle" Text="Sculpt" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ToolHelp" Style="{StaticResource Note}" Margin="0,8,0,0" Text="Left drag on the head pulls the surface under the brush."/>

                <!-- Sculpt brush -->
                <StackPanel x:Name="GroupBrush">
                  <TextBlock Text="Brush size" Style="{StaticResource Label}"/>
                  <Slider x:Name="Radius" Minimum="1" Maximum="45" Value="12" AutoToolTipPlacement="TopLeft" ToolTip="How much of the head the brush moves (% of the head)"/>
                  <TextBlock Text="Strength (for the nudge buttons)" Style="{StaticResource Label}"/>
                  <Slider x:Name="Strength" Minimum="0.1" Maximum="3" Value="0.4" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/>
                </StackPanel>
                <!-- Shape options shared by sculpt, vertex and shape pins -->
                <StackPanel x:Name="GroupShapeOptions" Margin="0,8,0,0">
                  <CheckBox x:Name="Symmetry" Content="Mirror left and right" IsChecked="True" Margin="0,2" ToolTip="Changes on one side of the face are copied to the other side."/>
                  <CheckBox x:Name="LockNeck" Content="Keep the neck in place" IsChecked="True" Margin="0,2" ToolTip="The lowest 10% of the head never moves, so it still joins the body."/>
                </StackPanel>
                <!-- Nudge and proportion of the clicked spot (sculpt) -->
                <StackPanel x:Name="GroupNudge" Margin="0,10,0,0">
                  <TextBlock Text="Adjust the clicked spot" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Note}" Text="Click a feature first (nose, chin, cheek…). Brush size sets how much moves."/>
                  <UniformGrid Columns="3" Margin="0,4,0,0">
                    <Button Style="{StaticResource Nudge}" Content="&#x2190; Left" Tag="-1,0,0" Click="OnMove" ToolTip="Move left (X −)"/>
                    <Button Style="{StaticResource Nudge}" Content="Up &#x2191;" Tag="0,1,0" Click="OnMove" ToolTip="Move up (Y +)"/>
                    <Button Style="{StaticResource Nudge}" Content="Right &#x2192;" Tag="1,0,0" Click="OnMove" ToolTip="Move right (X +)"/>
                    <Button Style="{StaticResource Nudge}" Content="Back" Tag="0,0,-1" Click="OnMove" ToolTip="Push in (Z −)"/>
                    <Button Style="{StaticResource Nudge}" Content="Down &#x2193;" Tag="0,-1,0" Click="OnMove" ToolTip="Move down (Y −)"/>
                    <Button Style="{StaticResource Nudge}" Content="Forward" Tag="0,0,1" Click="OnMove" ToolTip="Pull out (Z +)"/>
                  </UniformGrid>
                  <Button Content="Smooth the spot" Click="OnSmooth" Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <Expander Header="Width / height / depth" Margin="0,6,0,0">
                    <StackPanel Margin="0,4,0,0">
                      <TextBlock Text="Width" Style="{StaticResource Label}"/><Slider x:Name="FeatureWidth" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
                      <TextBlock Text="Height" Style="{StaticResource Label}"/><Slider x:Name="FeatureHeight" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
                      <TextBlock Text="Depth" Style="{StaticResource Label}"/><Slider x:Name="FeatureDepth" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
                      <Button Content="Apply to the clicked spot" Click="OnProportion" Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
                <!-- Shape pins -->
                <StackPanel x:Name="GroupShapePins">
                  <TextBlock Text="Pin influence" Style="{StaticResource Label}"/>
                  <Slider x:Name="ShapePinReach" Minimum="5" Maximum="65" Value="35" AutoToolTipPlacement="TopLeft" ToolTip="How much of the head follows a dragged pin (% of the head)"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Remove selected pin" Click="OnRemoveShapePin" Style="{StaticResource PanelButton}"/>
                    <Button Content="Clear pins" Click="OnClearShapePins" Style="{StaticResource PanelButton}"/>
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Note}" Text="Load a photo under Reference photos and line it up with Move photo first. Right-click a pin to remove it."/>
                </StackPanel>
                <!-- Paint colour -->
                <StackPanel x:Name="GroupColour">
                  <TextBlock Text="Colour" Style="{StaticResource Label}"/>
                  <DockPanel>
                    <Border x:Name="HeadSwatch" Width="34" Height="34" BorderBrush="#333" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonDown="OnHeadSwatchClick" ToolTip="Paint colour: click for any colour. Alt (or I) over the head picks the colour under the cursor."/>
                    <WrapPanel x:Name="HeadSwatches"/>
                  </DockPanel>
                </StackPanel>
                <!-- Texture brush -->
                <StackPanel x:Name="GroupTextureBrush">
                  <TextBlock Text="Brush size (px)  ·  [ and ]" Style="{StaticResource Label}"/>
                  <Slider x:Name="HeadBrushSize" Minimum="4" Maximum="300" Value="40" ValueChanged="OnBrushSize" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
                  <TextBlock Text="Strength" Style="{StaticResource Label}"/>
                  <Slider x:Name="HeadBrushStrength" Minimum="0.05" Maximum="1" Value="0.4" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
                </StackPanel>
                <!-- Pin warp -->
                <StackPanel x:Name="GroupPinWarp">
                  <TextBlock Text="Pin reach" Style="{StaticResource Label}"/>
                  <Slider x:Name="PinReach" Minimum="1" Maximum="20" Value="5" ValueChanged="OnPinReach" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
                    ToolTip="How far around each pin the texture follows it (% of the texture). The ring at the cursor shows it."/>
                  <CheckBox x:Name="MirrorPins" Content="Mirror pins to the other side" IsChecked="True" Click="OnMirrorPins" Margin="0,8,0,0"
                    ToolTip="A pin on one side of the face also acts on the other side (faded rings). Your own pins on the other side win."/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Remove pin" Click="OnRemovePin" Style="{StaticResource PanelButton}" ToolTip="Removes the selected (blue) pin. Delete key does the same."/>
                    <Button Content="Clear pins" Click="OnClearPins" Style="{StaticResource PanelButton}"/>
                  </WrapPanel>
                </StackPanel>
                <!-- Move photo -->
                <StackPanel x:Name="GroupPhoto">
                  <TextBlock Text="Photo shown" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="ReferenceMode" SelectedIndex="0" SelectionChanged="OnReferenceMode"><ComboBoxItem Content="Hidden"/><ComboBoxItem Content="Front photo"/><ComboBoxItem Content="Side photo"/></ComboBox>
                  <TextBlock Text="Opacity" Style="{StaticResource Label}"/><Slider x:Name="ReferenceOpacity" Minimum="0" Maximum="1" Value="0.4" ValueChanged="OnReferenceSetting"/>
                  <TextBlock Text="Size" Style="{StaticResource Label}"/><Slider x:Name="ReferenceScale" Minimum="0.2" Maximum="3" Value="1" ValueChanged="OnReferenceSetting"/>
                  <CheckBox x:Name="ReferenceOverlay" Content="Draw in front of the head" IsChecked="True" Checked="OnReferenceOption" Unchecked="OnReferenceOption" Margin="0,8,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ===== Mesh parts (layers) ===== -->
            <Expander Style="{StaticResource Section}" IsExpanded="True">
              <Expander.Header>
                <StackPanel Style="{StaticResource SectionHeader}"><TextBlock Text="&#xE81E;" Style="{StaticResource SectionIcon}"/><TextBlock Text="Mesh parts" Style="{StaticResource SectionTitle}"/></StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="Tools move every part near the brush so eyes and hair follow the face. Lock a part to keep its shape."/>
                <ListBox x:Name="PartPicker" SelectionChanged="OnPartChanged" MaxHeight="150" Margin="0,4,0,6" BorderBrush="#E1E5EA"/>
                <WrapPanel>
                  <Button Click="OnLockOthers" Style="{StaticResource PanelButton}" ToolTip="Only the selected part can change shape.">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0"/><TextBlock Text="Lock all but selected"/></StackPanel>
                  </Button>
                  <Button Click="OnUnlockAll" Style="{StaticResource PanelButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE785;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0"/><TextBlock Text="Unlock all"/></StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Expander>

            <!-- ===== Hair ===== -->
            <Expander Style="{StaticResource Section}">
              <Expander.Header>
                <StackPanel Style="{StaticResource SectionHeader}"><TextBlock Text="&#xE771;" Style="{StaticResource SectionIcon}"/><TextBlock Text="Hair" Style="{StaticResource SectionTitle}"/></StackPanel>
              </Expander.Header>
              <StackPanel>
                <Button Content="Add hair from a template…" Click="OnAddHair" Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,4,0,4"
                  ToolTip="For a head whose hair is painted on the face texture: a template head with a hair mesh takes this head's shape, face texture and eyes."/>
                <TextBlock Style="{StaticResource Note}" Text="For a head with a hair mesh: Volume makes it fuller or flatter (around the clicked spot, or all of it). Sculpt changes its outline."/>
                <WrapPanel Margin="0,4,0,0">
                  <Button Content="Select hair" Click="OnSelectHair" Style="{StaticResource PanelButton}"/>
                  <Button Content="Volume +" Tag="1" Click="OnHairVolume" Style="{StaticResource PanelButton}"/>
                  <Button Content="Volume &#x2212;" Tag="-1" Click="OnHairVolume" Style="{StaticResource PanelButton}"/>
                </WrapPanel>
                <CheckBox x:Name="WholeHair" Content="Whole hair" IsChecked="True"/>
              </StackPanel>
            </Expander>

            <!-- ===== Reference photos ===== -->
            <Expander Style="{StaticResource Section}">
              <Expander.Header>
                <StackPanel Style="{StaticResource SectionHeader}"><TextBlock Text="&#xE722;" Style="{StaticResource SectionIcon}"/><TextBlock Text="Reference photos" Style="{StaticResource SectionTitle}"/></StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="Show a photo behind or over the head to sculpt by eye. Line it up with the Move photo tool; double-click a thumbnail to crop."/>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Button Content="Front photo…" Click="OnReference" Tag="front" Style="{StaticResource PanelButton}" Margin="0,0,0,4"/>
                    <Border Background="#E9ECF0" Height="120" CornerRadius="3"><Image x:Name="FrontReference" Stretch="Uniform" MouseLeftButtonDown="OnReferenceThumbnail" Cursor="Hand" ToolTip="Double-click to crop"/></Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Button Content="Side photo…" Click="OnReference" Tag="side" Style="{StaticResource PanelButton}" Margin="0,0,0,4"/>
                    <Border Background="#E9ECF0" Height="120" CornerRadius="3"><Image x:Name="SideReference" Stretch="Uniform" MouseLeftButtonDown="OnReferenceThumbnail" Cursor="Hand" ToolTip="Double-click to crop"/></Border>
                  </StackPanel>
                </Grid>
                <Expander x:Name="PhotoProportions" Header="Match proportions with shape pins" Expanded="OnPhotoProportionsOpened" Collapsed="OnPhotoProportionsClosed" Margin="0,10,0,0">
                  <StackPanel Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Note}" Text="Opening this selects the Shape pins tool. Load a photo, line it up with Move photo, then click the head to add a pin and drag it onto the matching feature. Other pins hold their spots."/>
                    <WrapPanel>
                      <Button Content="Load front photo…" Tag="front" Click="OnShapeReference" Style="{StaticResource PanelButton}"/>
                      <Button Content="Load side photo…" Tag="side" Click="OnShapeReference" Style="{StaticResource PanelButton}"/>
                    </WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>

            <TextBlock Style="{StaticResource Note}" Margin="2,6,2,0" Text="Mesh parts, UVs and texture bindings stay as the game expects. Check saved faces in game before sharing them."/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
