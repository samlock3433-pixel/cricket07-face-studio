<Window x:Class="Cricket07.FaceStudio.Views.FaceSculptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Face Studio — Head and hair editor" Width="1280" Height="840" MinWidth="950" MinHeight="600"
        Closing="OnClosing" Closed="OnClosed" PreviewKeyDown="OnKey" PreviewKeyUp="OnKeyUp">
  <DockPanel Margin="12" Background="White">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button x:Name="ExportButton" Content="Save as .big…" Click="OnExport" Background="#234E74" Foreground="White" Padding="10,6" Margin="0,0,8,0"
        ToolTip="Saves the face you made as a .big file (model.o + textures.fsh) wherever you choose."/>
      <Button Content="Save project…" Click="OnSave" Padding="10,6" Margin="0,0,8,0"/>
      <Button Content="Load project…" Click="OnLoad" Padding="10,6" Margin="0,0,8,0"/>
      <Button Content="Undo" Click="OnUndo" Padding="10,6" Margin="0,0,8,0"/>
      <Button Content="Redo" Click="OnRedo" Padding="10,6" Margin="0,0,8,0"/>
      <Button Content="Likeness from photos…" Click="OnLikeness" Padding="10,6" Margin="0,0,8,0" ToolTip="Fit the head shape to a front and a side photo"/>
      <Button Content="Wrap UV texture…" Click="OnTexture" Padding="10,6" Margin="0,0,8,0"/>
      <Button Content="Front reference…" Click="OnReference" Tag="front" Padding="10,6" Margin="0,0,8,0"/>
      <Button Content="Side reference…" Click="OnReference" Tag="side" Padding="10,6"/>
    </WrapPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0"
      Text="Select a mesh part, click the feature to edit, then move or smooth it. Export checks the .o by reopening it."/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
      <h:HelixViewport3D x:Name="Viewport" Background="#252B35" ZoomExtentsWhenLoaded="False" ShowViewCube="False" Focusable="True"
                        IsRotationEnabled="False" IsPanEnabled="False" IsZoomEnabled="False"
                        PreviewMouseDown="OnPointerDown" PreviewMouseMove="OnPointerMove" PreviewMouseUp="OnPointerUp" PreviewMouseWheel="OnWheel" LostMouseCapture="OnCaptureLost" MouseLeave="OnViewportLeave">
        <h:HelixViewport3D.Camera><PerspectiveCamera Position="0,0,3" LookDirection="0,0,-3" UpDirection="0,1,0" FieldOfView="35"/></h:HelixViewport3D.Camera>
        <h:SunLight/>
      </h:HelixViewport3D>
      <Canvas x:Name="PinLayer" IsHitTestVisible="False" ClipToBounds="True"/>
      <!-- Brush ring for texture paint: dark outline under a white line, visible on light and dark skin. -->
      <Canvas x:Name="CursorLayer" IsHitTestVisible="False" ClipToBounds="True">
        <Path x:Name="BrushRingShadow" Stroke="#A0000000" StrokeThickness="3" Visibility="Collapsed" StrokeLineJoin="Round"/>
        <Path x:Name="BrushRing" Stroke="White" StrokeThickness="1.2" Visibility="Collapsed" StrokeLineJoin="Round"/>
        <Ellipse x:Name="VertexMarker" Width="11" Height="11" Fill="#FFFFD23C" Stroke="Black" StrokeThickness="1.5" Visibility="Collapsed"/>
        <Ellipse x:Name="VertexMirrorMarker" Width="9" Height="9" Stroke="#FFFFD23C" StrokeThickness="1.5" Opacity="0.7" Visibility="Collapsed"/>
      </Canvas>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="4" CornerRadius="4" Background="#B0141820">
        <Border.Resources>
          <Style TargetType="Button"><Setter Property="Focusable" Value="False"/><Setter Property="MinWidth" Value="34"/><Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="4,2"/></Style>
        </Border.Resources>
        <StackPanel>
          <UniformGrid Columns="3">
            <Border/><Button Content="&#x25B2;" Tag="orbit-up" Click="OnNavigate" ToolTip="Tilt up (Up arrow)"/><Border/>
            <Button Content="&#x25C0;" Tag="orbit-left" Click="OnNavigate" ToolTip="Turn left (Left arrow)"/>
            <Button Content="Fit" Tag="fit" Click="OnNavigate" ToolTip="Show the whole head (F)"/>
            <Button Content="&#x25B6;" Tag="orbit-right" Click="OnNavigate" ToolTip="Turn right (Right arrow)"/>
            <Border/><Button Content="&#x25BC;" Tag="orbit-down" Click="OnNavigate" ToolTip="Tilt down (Down arrow)"/><Border/>
          </UniformGrid>
          <UniformGrid Columns="3" Margin="0,4,0,0">
            <Button Content="+" Tag="zoom-in" Click="OnNavigate" ToolTip="Zoom in (+, wheel, pinch)"/>
            <Button Content="&#x2212;" Tag="zoom-out" Click="OnNavigate" ToolTip="Zoom out (-, wheel, pinch)"/>
            <Button Content="Focus" Tag="focus" Click="OnNavigate" ToolTip="Frame the clicked feature"/>
          </UniformGrid>
          <UniformGrid Columns="3" Margin="0,4,0,0">
            <Button Content="Front" Tag="front" Click="OnNavigate" ToolTip="Front view (Home)"/>
            <Button Content="&#xBE;" Tag="threequarter" Click="OnNavigate" ToolTip="Three-quarter view"/>
            <Button Content="Back" Tag="back" Click="OnNavigate"/>
            <Button Content="Left" Tag="left" Click="OnNavigate"/>
            <Button Content="Right" Tag="right" Click="OnNavigate"/>
          </UniformGrid>
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#333"
            Text="Left drag: sculpt (or paint, with a Texture paint tool below) &#183; Right drag (or Alt + left drag): orbit &#183; add Shift to pan &#183; Wheel or pinch: zoom at the cursor &#183; Arrows: orbit &#183; F: fit &#183; Home: front &#183; Ctrl+Z / Ctrl+Y: undo / redo. View buttons are in the top-right corner of the 3D view."/>
          <TextBlock Text="Mesh parts" FontWeight="SemiBold" Margin="0,0,0,2"/>
          <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12" Margin="0,0,0,5"
            Text="Sculpt tools move every part near the brush, so eyes and hair follow the face. Lock a part to keep its shape: locked parts never move (sculpt, grab, single vertex, smooth, hair volume, likeness)."/>
          <ListBox x:Name="PartPicker" SelectionChanged="OnPartChanged" MaxHeight="150" Margin="0,0,0,5"/>
          <WrapPanel Margin="0,0,0,15">
            <Button Content="Lock all except selected" Click="OnLockOthers" Padding="8,3" Margin="0,0,6,0"
              ToolTip="Only the selected part can change shape."/>
            <Button Content="Unlock all" Click="OnUnlockAll" Padding="8,3"/>
          </WrapPanel>
          <TextBlock Text="Local feature sculpt" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Select the chin, nose, eyelid, cheek, or jaw directly on the mesh." TextWrapping="Wrap" Margin="0,5,0,12"/>
          <TextBlock Text="Brush radius (% of head bounds)"/>
          <Slider x:Name="Radius" Minimum="1" Maximum="45" Value="12" Margin="0,5,0,12"/>
          <TextBlock Text="Move strength (% of head bounds)"/>
          <Slider x:Name="Strength" Minimum="0.1" Maximum="3" Value="0.4" Margin="0,5,0,12"/>
          <CheckBox x:Name="Symmetry" Content="Mirror across head center X" IsChecked="True" Margin="0,0,0,8"/>
          <CheckBox x:Name="LockNeck" Content="Lock lowest 10% (Y axis)" IsChecked="True" Margin="0,0,0,10"/>
          <CheckBox x:Name="VertexMode" Content="Single vertex: left drag moves one point (V)" Click="OnVertexMode" Margin="0,0,0,4"
            ToolTip="For exact likeness on the low-poly head: the dot shows the vertex under the cursor; dragging moves only it (its seam copies and, with Mirror, its partner follow)."/>
          <CheckBox x:Name="ShowWireframe" Content="Show wireframe (W)" Click="OnWireframe" Margin="0,0,0,10"/>
          <WrapPanel>
            <Button Content="X −" Tag="-1,0,0" Click="OnMove" Padding="14,6" Margin="0,0,6,6"/>
            <Button Content="X +" Tag="1,0,0" Click="OnMove" Padding="14,6" Margin="0,0,6,6"/>
            <Button Content="Y −" Tag="0,-1,0" Click="OnMove" Padding="14,6" Margin="0,0,6,6"/>
            <Button Content="Y +" Tag="0,1,0" Click="OnMove" Padding="14,6" Margin="0,0,6,6"/>
            <Button Content="Z −" Tag="0,0,-1" Click="OnMove" Padding="14,6" Margin="0,0,6,6"/>
            <Button Content="Z +" Tag="0,0,1" Click="OnMove" Padding="14,6" Margin="0,0,6,6"/>
            <Button Content="Smooth region" Click="OnSmooth" Padding="14,6" Margin="0,0,6,6"/>
          </WrapPanel>
          <TextBlock Text="Feature proportions" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,6"/>
          <TextBlock Text="Click the nose, jaw, chin or eye region. Set its width, height and depth, then apply. Brush radius controls the affected area." TextWrapping="Wrap"/>
          <TextBlock Text="Width"/><Slider x:Name="FeatureWidth" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
          <TextBlock Text="Height"/><Slider x:Name="FeatureHeight" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
          <TextBlock Text="Depth"/><Slider x:Name="FeatureDepth" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
          <Button Content="Apply feature proportions" Click="OnProportion"/>
          <TextBlock Text="Hair" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,6"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
            Text="No hair mesh (hair painted on the face texture)? Use Add hair from a template. For heads with a hair mesh: Volume makes the hair fuller or flatter around the clicked spot (brush radius and strength above), or all of it with Whole hair. Grab (left drag) on the hair changes its outline and length; Smooth region evens it out."/>
          <Button Content="Add hair from a template…" Click="OnAddHair" Padding="10,6" Margin="0,0,0,6" HorizontalAlignment="Left"
            ToolTip="For a head without a hair mesh (hair painted on the face texture): a template head with hair takes this head's shape and face texture."/>
          <WrapPanel>
            <Button Content="Select hair" Click="OnSelectHair" Padding="10,6" Margin="0,0,6,6"/>
            <Button Content="Volume +" Tag="1" Click="OnHairVolume" Padding="10,6" Margin="0,0,6,6"/>
            <Button Content="Volume &#x2212;" Tag="-1" Click="OnHairVolume" Padding="10,6" Margin="0,0,6,6"/>
          </WrapPanel>
          <CheckBox x:Name="WholeHair" Content="Whole hair" IsChecked="True" Margin="0,0,0,6"/>
          <TextBlock Text="Texture paint" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,6"/>
          <TextBlock Text="Left drag on the head"/>
          <ComboBox x:Name="HeadTool" SelectedIndex="0" SelectionChanged="OnHeadTool" Margin="0,2,0,6">
            <ComboBoxItem Content="Sculpt (no paint)"/>
            <ComboBoxItem Content="Paint (Alt picks a colour)" Tag="Paint"/>
            <ComboBoxItem Content="Blur" Tag="Blur"/>
            <ComboBoxItem Content="Clone (Ctrl+click sets the source)" Tag="Clone"/>
            <ComboBoxItem Content="Pin warp: drag features into place" Tag="Pins"/>
          </ComboBox>
          <DockPanel Margin="0,0,0,6">
            <Border x:Name="HeadSwatch" Width="30" Height="30" BorderBrush="#333" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonDown="OnHeadSwatchClick" ToolTip="Paint colour: click for any colour. Alt (or I) over the head picks the colour under the cursor."/>
            <WrapPanel x:Name="HeadSwatches"/>
          </DockPanel>
          <TextBlock Text="Brush size (px)"/><Slider x:Name="HeadBrushSize" Minimum="4" Maximum="300" Value="40" ValueChanged="OnBrushSize" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
          <TextBlock Text="Strength"/><Slider x:Name="HeadBrushStrength" Minimum="0.05" Maximum="1" Value="0.4" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
          <TextBlock Text="Pin reach (% of texture)"/><Slider x:Name="PinReach" Minimum="1" Maximum="20" Value="5" ValueChanged="OnPinReach" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
            ToolTip="Pin warp: how far around each pin the texture follows it. The ring at the cursor shows it."/>
          <CheckBox x:Name="MirrorPins" Content="Mirror pins to the other side of the face" IsChecked="True" Click="OnMirrorPins" Margin="0,4,0,0"
            ToolTip="A pin on one side of the face also acts on the other side (faded rings). Your own pins on the other side win."/>
          <WrapPanel Margin="0,4,0,0">
            <Button Content="Remove pin" Click="OnRemovePin" Padding="10,4" Margin="0,0,6,0" ToolTip="Removes the selected (blue) pin. Delete key does the same."/>
            <Button Content="Clear pins" Click="OnClearPins" Padding="10,4"/>
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"
            Text="Pin warp is the way to line a painted moustache, beard edge, lip line or brow up with the head: drag the painted feature onto the right place and a pin stays there (yellow; the dashed line shows where it came from). Click without dragging to pin a spot so it stays put. Pins move only their surroundings and can be dragged again at any time; nothing smears. The brushes paint the texture of whatever you drag over (face or hair). A stroke stops at texture seams. Undo steps back through paint, pins and sculpt alike."/>

          <TextBlock Text="Viewport reference" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,6"/>
          <ComboBox x:Name="ReferenceMode" SelectedIndex="0" SelectionChanged="OnReferenceMode"><ComboBoxItem Content="Hidden"/><ComboBoxItem Content="Front image"/><ComboBoxItem Content="Side image"/></ComboBox>
          <CheckBox x:Name="ReferenceEdit" Content="Move reference only" Click="OnReferenceEdit" Margin="0,6,0,0"
            ToolTip="While ticked, left drag in the 3D view moves the reference photo. The head is not selected or sculpted."/>
          <CheckBox x:Name="ReferenceOverlay" Content="Draw in front of model" IsChecked="True" Checked="OnReferenceOption" Unchecked="OnReferenceOption" Margin="0,4,0,0"/>
          <TextBlock Text="Opacity"/><Slider x:Name="ReferenceOpacity" Minimum="0" Maximum="1" Value="0.4" ValueChanged="OnReferenceSetting"/>
          <TextBlock Text="Scale"/><Slider x:Name="ReferenceScale" Minimum="0.2" Maximum="3" Value="1" ValueChanged="OnReferenceSetting"/>
          <TextBlock Text="Tick 'Move reference only' and drag the photo in the 3D view to line up the eyes and chin; set its size with Scale. Double-click the photo (or its thumbnail below) to crop it; cropping only hides the rest. Choosing Front or Side image switches to that view." TextWrapping="Wrap"/>
          <TextBlock Text="Front reference" Margin="0,12,0,5" FontWeight="SemiBold"/>
          <Image x:Name="FrontReference" Height="180" Stretch="Uniform" MouseLeftButtonDown="OnReferenceThumbnail" Cursor="Hand" ToolTip="Double-click to crop"/>
          <TextBlock Text="Side reference" Margin="0,12,0,5" FontWeight="SemiBold"/>
          <Image x:Name="SideReference" Height="180" Stretch="Uniform" MouseLeftButtonDown="OnReferenceThumbnail" Cursor="Hand" ToolTip="Double-click to crop"/>
          <TextBlock Text="Head and hair keep their own mesh parts, UVs and texture bindings. References guide manual sculpting; photos are not automatically projected. Validate exported assets in game before using them in a patch."
                     Foreground="#665544" TextWrapping="Wrap" Margin="0,15,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>

