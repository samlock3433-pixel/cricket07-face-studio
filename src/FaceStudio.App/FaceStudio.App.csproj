<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cricket07.FaceStudio</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FaceStudio.Core/FaceStudio.Core.csproj" />
    <PackageReference Include="HelixToolkit.Wpf" Version="2.27.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../templates/**/*" Link="templates/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/otools/**/*" Link="tools/otools/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/facemesh/**/*" Link="tools/facemesh/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
