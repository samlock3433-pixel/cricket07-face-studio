<Window x:Class="Cricket07.FaceStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cricket 07 Face Studio" Width="1020" Height="730" MinWidth="850" MinHeight="620" Background="#F3F4F7">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Cricket 07 Face Studio" FontSize="30" FontWeight="SemiBold" Foreground="#172237"/>
   <TextBlock Text="Start from a stock head (heads marked 'with hair' have a 3D hair mesh you can shape and paint), or open a face .big." Margin="0,8,0,22" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" Text="Choose a template to begin. Originals are kept unchanged." TextWrapping="Wrap" Margin="0,16,0,10"/>
   <TextBlock Text="Exports use the Cricket 07 converter and are reopened for geometry checks. In-game testing is still required." TextWrapping="Wrap" Foreground="#646D7C"/>
  </StackPanel>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="1. Choose a head" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <ListBox x:Name="Heads" Height="340" Padding="8">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,3">
      <Image Source="{Binding PreviewPath}" Width="80" Height="72" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="15"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="These are editable copies extracted from your local Cricket 07 assets." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#646D7C"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="2. Start" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="Hair is part of the head: a head 'with hair' keeps its hair mesh in the saved face .big, where you can shape it (Volume, grab, smooth) and paint it on the 3D view. Other heads have hair painted on the face texture." TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#646D7C"/>
    <Button x:Name="StartButton" Content="Start with selected head" Click="OnStart" FontSize="16" Background="#234E74" Foreground="White"/>
    <Button x:Name="OpenButton" Content="Open face (.big / .o)…" Click="OnOpen"/>
    <Button Content="Texture search and replacement…" Click="OnTextures"/>
   </StackPanel>
   <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0">
    <Button DockPanel.Dock="Right" Content="Choose OTools…" Click="OnChooseConverter"/>
    <TextBlock x:Name="ConverterInfo" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#646D7C"/>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
